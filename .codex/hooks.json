{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/hooks.py\" --hook SessionStart",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do py -3 \"%i/.codex/hooks/scripts/hooks.py\" --hook SessionStart",
            "timeout": 10,
            "statusMessage": "Loading project context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/hooks.py\" --hook PreToolUse",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do py -3 \"%i/.codex/hooks/scripts/hooks.py\" --hook PreToolUse",
            "timeout": 10,
            "statusMessage": "Running pre-tool-use hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/hooks.py\" --hook PostToolUse",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do py -3 \"%i/.codex/hooks/scripts/hooks.py\" --hook PostToolUse",
            "timeout": 10,
            "statusMessage": "Running post-tool-use hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/hooks.py\" --hook Stop",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do py -3 \"%i/.codex/hooks/scripts/hooks.py\" --hook Stop",
            "timeout": 10,
            "statusMessage": "Running session stop hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/scripts/hooks.py\" --hook UserPromptSubmit",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do py -3 \"%i/.codex/hooks/scripts/hooks.py\" --hook UserPromptSubmit",
            "timeout": 10,
            "statusMessage": "Running user prompt submit hook"
          }
        ]
      }
    ]
  }
}
