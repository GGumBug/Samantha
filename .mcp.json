{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "deepwiki": {
      "command": "npx",
      "args": ["-y", "deepwiki-mcp"]
    },
    "google-sheets": {
      "command": "uvx",
      "args": [
        "--from",
        "mcp-google-sheets",
        "--with",
        "mcp<2",
        "mcp-google-sheets"
      ],
      "env": {
        "SERVICE_ACCOUNT_PATH": "${DOUBLEDOWN_SHEETS_KEY}",
        "ENABLED_TOOLS": "get_sheet_data,update_cells,batch_update_cells,add_rows,list_spreadsheets,search_spreadsheets,list_sheets,create_spreadsheet,create_sheet,get_multiple_spreadsheet_summary"
      }
    }
  }
}
